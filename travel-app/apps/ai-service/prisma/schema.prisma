generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TravelPlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  DELETED

  @@map("travel_plan_status")
}

enum RecommendationType {
  PLACE
  HOTEL
  RESTAURANT
  POST
  FRIEND

  @@map("recommendation_type")
}

model travel_plan {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String           @db.Uuid
  title       String
  destination String
  input       Json
  content     String
  status      TravelPlanStatus @default(ACTIVE)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  items travel_plan_item[]

  @@index([user_id, created_at(sort: Desc)])
  @@map("travel_plan")
}

model travel_plan_item {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  travel_plan_id String   @db.Uuid
  day_index      Int
  time_slot      String?
  activity_name  String
  location_id    String?  @db.Uuid
  description    String?
  cost_estimate  Decimal? @db.Decimal(10, 2)

  travel_plan travel_plan @relation(fields: [travel_plan_id], references: [id], onDelete: Cascade)

  @@index([travel_plan_id])
  @@index([travel_plan_id, day_index])
  @@map("travel_plan_item")
}

model recommendation_log {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String             @db.Uuid
  type         RecommendationType
  reference_id String             @db.Uuid
  score        Float?
  created_at   DateTime           @default(now())

  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, type])
  @@index([reference_id])
  @@map("recommendation_log")
}