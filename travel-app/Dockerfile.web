FROM node:22-alpine

WORKDIR /apps

# Copy workspace manifests
COPY package.json package-lock.json .npmrc ./

# Copy package.json của web
COPY apps/web/package.json ./apps/web/package.json

# Cài dependencies cho workspace web
RUN npm ci --workspace=web --include=optional --include=dev --no-audit --no-fund

# Copy source web
COPY apps/web ./apps/web

# Build Next.js
RUN npm run build --workspace=web

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=web"]